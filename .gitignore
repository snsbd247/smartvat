# Dependencies
/backend/vendor/
/frontend/node_modules/
node_modules/

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
/deploy/secrets/

# Build output
/frontend/dist/
/backend/public/build/
/backend/public/hot

# Generated SPA artifacts published into Laravel (produced by deploy/build-local.sh)
/backend/public/assets/
/backend/public/favicon.svg
/backend/public/icons.svg
/backend/resources/views/spa.blade.php

# Laravel runtime
/backend/storage/*.key
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/bootstrap/cache/*

# Backups / generated artifacts
/backup-staging/
*.sqlite
*.sqlite-journal

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
/backend/coverage/
/frontend/coverage/
.phpunit.result.cache
