# Install both, then: sudo systemctl enable --now plastex-scheduler.timer
# (Alternatively add a crontab: * * * * * php /var/www/plastex/backend/artisan schedule:run)
[Unit]
Description=Run PLASTEX ERP scheduler every minute

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
